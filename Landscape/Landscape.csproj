<Project Sdk="Microsoft.NET.Sdk">

    <!-- The library both engines reference from their own projects, which knows no engine
         (N 2.1). -->
    <!-- The assembly and the package are 3DEngine.Landscape and the namespace Landscape alone, so
         code names a type as Landscape.Heightfield whichever assembly name a package gives. -->
    <PropertyGroup>
        <AssemblyName>3DEngine.Landscape</AssemblyName>
        <PackageId>3DEngine.Landscape</PackageId>
        <RootNamespace>Landscape</RootNamespace>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <!-- Every public member has a summary (STYLE.md), so a missing one stops the build, as a cref
         that names nothing does. -->
    <PropertyGroup>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <WarningsAsErrors>$(WarningsAsErrors);CS1591;CS1574</WarningsAsErrors>
    </PropertyGroup>

    <!-- The tests apply a step to a field they made, which a recipe's build does from flat ground
         alone. -->
    <ItemGroup>
        <InternalsVisibleTo Include="3DEngine.Landscape.Tests" />
    </ItemGroup>

</Project>
